---
// Pie negro: mantel de cuadros arriba, el nombre en rojo a todo el ancho, eslogan y cuatro columnas (horario,
// dónde estamos, pedidos y contacto, menú y redes) con todo lo de site.yaml → contacto. Aviso legal y
// «Web creada con NoExpertise» si site.yaml → marca_pie no es false (plan gratis).
// En móvil, barra fija abajo con «Llamar» y «WhatsApp» (solo los que haya en contacto).
import { site, tel, mapa, whatsapp } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'rotulo' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const wa = whatsapp(c.whatsapp, `Hola, quiero hacer un pedido en ${site.nombre}`);
---

<footer class={`pie pie--${variante}`}>
  <div class="mantel" aria-hidden="true"></div>
  <div class="contenedor">
    <p class="pie-marca">{site.nombre}</p>
    {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
    <div class="pie-columnas">
      {
        c.horario && (
          <div>
            <p class="pie-titulo">Horario</p>
            <p class="pie-texto">{c.horario}</p>
          </div>
        )
      }
      {
        c.direccion && (
          <div>
            <p class="pie-titulo">Dónde estamos</p>
            <p class="pie-texto">
              <a href={mapa(c.direccion)} rel="noopener" target="_blank" class="underline underline-offset-4">{c.direccion}</a>
            </p>
          </div>
        )
      }
      {
        (c.telefono || c.whatsapp || c.email) && (
          <div>
            <p class="pie-titulo">Pedidos</p>
            <ul class="pie-lista">
              {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
              {c.whatsapp && <li><a href={wa} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
              {c.email && <li><a href={`mailto:${c.email}`} class="break-all">{c.email}</a></li>}
            </ul>
          </div>
        )
      }
      {
        (site.menu.length > 0 || redes.length > 0) && (
          <div>
            {site.menu.length > 0 && (
              <>
                <p class="pie-titulo">En esta web</p>
                <ul class="pie-lista">
                  {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
                </ul>
              </>
            )}
            {redes.length > 0 && (
              <ul class="pie-redes">
                {redes.map(([red, url]) => (
                  <li>
                    <a href={url} rel="noopener" target="_blank" aria-label={red}>
                      <Icono nombre={red} tam={20} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
  {
    (c.telefono || c.whatsapp) && (
      <nav class="barra-movil" aria-label="Pedir por teléfono o WhatsApp">
        {c.telefono && (
          <a href={tel(c.telefono)}>
            <Icono nombre="telefono" tam={20} /> Llamar
          </a>
        )}
        {c.whatsapp && (
          <a href={wa} rel="noopener" target="_blank">
            <Icono nombre="whatsapp" tam={20} /> WhatsApp
          </a>
        )}
      </nav>
    )
  }
</footer>
